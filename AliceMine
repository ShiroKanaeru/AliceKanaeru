local function refreshStatus()

    local crystals =
        getCrystalTools()

    local plot =
        getOwnPlot()

    local remoteNames = {
        "TakeOutAllCrystals",
        "ToggleFavorite",
        "GoHome",
        "SellRequest"
    }

    local found = 0

    for _, name in ipairs(remoteNames) do

        if checkRemote(name) then
            found += 1
        end
    end

    CrystalCountLabel:SetText(
        "Crystals: "
        .. tostring(#crystals)
    )

    PlotStatusLabel:SetText(
        "Plot: "
        .. (plot and "Found" or "Not Found")
    )

    RemoteStatusLabel:SetText(
        "Remotes: "
        .. tostring(found)
        .. "/"
        .. tostring(#remoteNames)
    )
end

