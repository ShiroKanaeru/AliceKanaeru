--====================================================--
-- REMOTE CHECK
--====================================================--

local RemoteGroup =
    Tabs.Main:AddLeftGroupbox(
        "Remote Check"
    )

RemoteGroup:AddButton({

    Text =
        "Check All Remotes",

    Func = function()

        local names = {
            "TakeOutAllCrystals",
            "ToggleFavorite",
            "GoHome",
            "SellRequest"
        }

        local found = 0

        for _, name in ipairs(names) do

            local remote =
                checkRemote(name)

            if remote then

                found += 1

                print(
                    "[Alice Remote]",
                    name,
                    "=>",
                    remote.ClassName,
                    remote:GetFullName()
                )

            else

                warn(
                    "[Alice Remote Missing]",
                    name
                )
            end
        end

        refreshStatus()

        notify(
            "Remote Check",
            tostring(found)
            .. "/"
            .. tostring(#names)
            .. " remotes found",
            4
        )
    end
})

